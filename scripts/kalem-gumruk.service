[Unit]
Description=Kalem Gumruk Musavirligi Monorepo Application (PM2 Manager)
After=network.target

[Service]
Type=forking
User=root
WorkingDirectory=/var/www/kalemgumruk
Environment=PATH=/usr/bin:/usr/local/bin
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/pm2 start /var/www/kalemgumruk/ecosystem.config.cjs --env production
ExecReload=/usr/local/bin/pm2 reload /var/www/kalemgumruk/ecosystem.config.cjs --env production
ExecStop=/usr/local/bin/pm2 stop /var/www/kalemgumruk/ecosystem.config.cjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
