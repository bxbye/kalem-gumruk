# ==========================================
# Kalem Gümrük Müşavirliği - Çevre Değişkenleri Şablonu (.env.example)
# ==========================================

# 1. Ortam ve Port Ayarları
NODE_ENV=development
PORT=5001
BACKEND_PORT=5001
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:5001

# 2. Yönetici ve Editör Giriş Bilgileri
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kalem1997
EDITOR_USERNAME=editor
EDITOR_PASSWORD=editor1997

# 3. SMTP E-Posta Bildirim Ayarları
# Kurumsal sunucu / cPanel için: mail.kalemgumruk.com | Port: 465 (SSL) veya 587 (TLS)
# Gmail için: smtp.gmail.com | Port: 465 (SSL) veya 587 (TLS)
SMTP_SERVICE=
SMTP_HOST=mail.kalemgumruk.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@kalemgumruk.com
SMTP_PASS=BURAYA_PAROLANIZI_YAZIN
SMTP_FROM="Kalem Gümrük Müşavirliği" <info@kalemgumruk.com>

# Form ve Chatbot bildirimlerinin geleceği yetkili e-posta adresi:
CONTACT_RECEIVER=info@kalemgumruk.com

# 4. Güvenlik ve Oturum
SESSION_SECRET=kalem_gumruk_super_secure_session_key_2026
