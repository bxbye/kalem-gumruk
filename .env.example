# 1. Ortam ve Port Ayarları
NODE_ENV=development
PORT=5001
BACKEND_PORT=5001
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:5001

# 2. Yönetici ve Editör Giriş Bilgileri
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kalem1997
EDITOR_USERNAME=editor
EDITOR_PASSWORD=editor1997

# 3. SMTP E-Posta Bildirim Ayarları (Nodemailer ile Tamamen Bağımsız ve Ücretsiz)
# Gmail için: smtp.gmail.com | Port: 465 (SSL) veya 587 (TLS)
# Kurumsal sunucu / cPanel için: mail.kalemgumruk.com | Port: 465 / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kdrky57@gmail.com
SMTP_PASS=uygulama_sifreniz_buraya
SMTP_FROM="Kalem Gümrük Müşavirliği" <kdrky57@gmail.com>

# Form ve Chatbot bildirimlerinin geleceği yetkili e-posta adresi:
CONTACT_RECEIVER=kadir.kaya@kayapermit.com

# 4. Güvenlik ve Oturum
SESSION_SECRET=kalem_gumruk_super_secure_session_key_2026
